        code = msg.get("keycode") or KEY_MAP.get(key, 0)
        if text: ok, det = run_adb(ip, ["shell", "input", "text", text])
        elif pkg: ok, det = run_adb(ip, ["shell", "monkey", "-p", pkg, "1"])
        elif code: ok, det = run_adb(ip, ["shell", "input", "keyevent", str(code)])
        else: ok, det = False, "No keycode"
        await ws.send(json.dumps({"type": "command_result", "key": key, "success": ok, "details": det}))

async def main():
    print(f"DRemote Bridge listening on ws://{HOST}:{PORT}")
    async with websockets.serve(handler, HOST, PORT): await asyncio.Future()

if __name__ == "__main__": asyncio.run(main())

